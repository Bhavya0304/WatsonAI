# ---------- LLM providers (fallback order: OpenAI → Gemini → Groq) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- OpenAI budget guards (USD) ----------
# $15 prepaid, ~10 visitors/month. gpt-4.1-mini is ~$0.003/message with RAG.
OPENAI_SESSION_CAP=0.10      # ~30 messages per conversation, then Gemini
OPENAI_IP_DAILY_CAP=0.20     # per visitor IP per rolling 24h
OPENAI_MONTHLY_CAP=2.00      # whole site per calendar month
OPENAI_LIFETIME_CAP=14.00    # hard stop, leaves $1 margin. Reset from the dashboard after a top-up.

# ---------- Abuse limits ----------
RATE_LIMIT_MESSAGES=15       # messages per IP...
RATE_LIMIT_WINDOW_S=300      # ...per 5 minutes
MAX_MESSAGE_CHARS=800
MAX_MESSAGES_PER_SESSION=80

# ---------- Transcript email (Gmail App Password: myaccount.google.com/apppasswords) ----------
NOTIFY_EMAIL=jshi.bhavya@gmail.com
SMTP_USER=
SMTP_APP_PASSWORD=
SESSION_IDLE_MINUTES=30

# ---------- Admin dashboard (/admin) ----------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in production (HTTPS)
COOKIE_SECURE=false

# ---------- Misc ----------
LOG_RETENTION_DAYS=30
GEO_ENABLED=true
